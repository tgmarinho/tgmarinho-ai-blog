# Ask Thiago feature flag
NEXT_PUBLIC_FF_ASK_ENABLED=false

# Optional: enables synthesized answers for /api/ask through Vercel AI Gateway.
# Without this, Ask falls back to local public-corpus search.
ASK_THIAGO_MODEL=anthropic/claude-haiku-4.5
ASK_THIAGO_MAX_OUTPUT_TOKENS=400

# Use a Vercel AI Gateway key here, not an Anthropic/OpenAI/Google provider key.
# VERCEL_OIDC_TOKEN is normally provided by Vercel at runtime, do not paste one manually.
# AI_GATEWAY_API_KEY=
# VERCEL_OIDC_TOKEN=

# Newsletter
# BUTTONDOWN_API_KEY=

# Future persistent counters/feedback store
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
